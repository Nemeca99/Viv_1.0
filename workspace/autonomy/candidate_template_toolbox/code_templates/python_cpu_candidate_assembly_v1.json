{
  "schema_version": "viv_cpu_candidate_assembly_contract_v1",
  "status": "ISOLATED_CANDIDATE_ONLY",
  "purpose": "Allow bounded reverse-engineering and self-repair without allowing architecture rewrite.",
  "model_request_schema": "viv_cpu_candidate_assembly_request_v1",
  "model_allowed_fields": [
    "candidate_id",
    "pillar",
    "blocks",
    "variable_overrides"
  ],
  "block_fields": ["template_id", "section"],
  "block_source": "approved_registry_and_source_index_only",
  "copy_rule": "copy_exact_indexed_utf8_spans_without_formatting_or_body_generation",
  "required_sections": ["VARIABLES", "main"],
  "ordering": ["__imports__", "VARIABLES", "main", "sub_main_*"],
  "variable_rule": "runtime_data_only_declared_keys_only",
  "own_candidate_file_rule": {
    "rewrite_own_isolated_candidates": true,
    "structure_immutable": true,
    "section_order_locked_for_existing_names": true,
    "new_submains_may_append_after_main": true,
    "variables_mutable": true,
    "variable_keys_add_only_when_indexed_template_declares": true,
    "functions_cpu_written_from_index_only": true,
    "functions_add_only": true,
    "functions_delete_forbidden": true,
    "same_name_function_replace_forbidden": true,
    "function_body_rewrite_forbidden": true,
    "variable_key_delete_forbidden": true,
    "import_delete_forbidden": true,
    "import_replace_forbidden": true,
    "file_delete_forbidden": true,
    "rename_in_place_forbidden": true,
    "clone_to_new_candidate_id_allowed": true,
    "supersede_is_clone_not_replace": true,
    "human_archive_is_only_delete": true,
    "failed_add_stays_on_disk": true,
    "failed_append_does_not_delete": true,
    "clone_is_escape_hatch_when_add_only_cannot_express_change": true
  },
  "allow": [
    "create_new_isolated_candidate_from_indexed_spans",
    "rewrite_variables_values_in_owned_file",
    "add_declared_variable_key_when_indexed_template_declares_it_and_old_keys_remain",
    "append_indexed_sub_main_spans",
    "append_indexed_import_spans",
    "clone_to_new_candidate_id_old_file_stays",
    "use_run_existing_tool_without_mutating",
    "runtime_overrides_for_one_call_do_not_persist_unless_variables_rewrite",
    "read_own_candidates",
    "hold_or_abstain_as_first_class_results",
    "append_receipts_and_ledger_rows",
    "choose_template_ids_and_variable_slots_model_surface_cpu_writes_file"
  ],
  "deny": [
    "reorder___imports___variables_main_sub_main",
    "rename_function_file_or_candidate_id_in_place",
    "change_section_markers_main_signature_decorators_or_annotations",
    "replace_main_with_different_template_main_of_same_name",
    "rewrite_function_body_even_if_equivalent_or_whitespace_only",
    "add_helpers_that_are_not_indexed_sub_main",
    "put_code_imports_or_logic_inside_variables",
    "make_variables_anything_but_a_literal_dict",
    "unlink_empty_truncate_overwrite_from_scratch",
    "drop_a_function_import_line_or_variable_key",
    "replace_an_import_delete_plus_add",
    "move_a_file_out_of_the_isolated_root",
    "symlink_or_reparse_tricks",
    "ttl_gc_cleanup_deletion",
    "merge_two_files_by_dropping_any_old_span",
    "touch_source_templates_registry_pointer_seed0_protected_mains_rust",
    "write_outside_sandbox_code_template_candidates",
    "publish_promote_or_adopt",
    "execute_main_at_import",
    "shell_delete_of_tools_or_evidence",
    "delete_or_rewrite_receipts_journals_ledgers",
    "same_name_function_from_a_new_template"
  ],
  "proof_rule": {
    "new_functions_supseteq_old_functions": true,
    "new_function_bytes_equal_old_for_every_old_name": true,
    "new_imports_supseteq_old_imports": true,
    "new_variable_keys_supseteq_old_variable_keys": true,
    "variables_values_may_change": true,
    "file_still_exists_at_the_same_path": true,
    "on_fail": "HOLD_and_keep_the_old_file"
  },
  "new_file_rule": {
    "output_path": "cpu_derived_under_sandbox_code_template_candidates",
    "path_is_model_supplied": false,
    "existing_file_overwrite": false,
    "existing_file_variables_rewrite": true,
    "existing_file_function_body_rewrite": false,
    "source_template_edit": false,
    "registry_edit": false,
    "active_pointer_edit": false,
    "production_generation_edit": false
  },
  "security": {
    "rust_python_write_probe_required": true,
    "rust_denial_respected": true,
    "test_only_local_assembly_allowed": true,
    "test_adapter_is_never_production_authority": true,
    "human_approval_required_before_template_insertion": true
  },
  "self_repair_boundary": {
    "reverse_engineer_existing_behavior": true,
    "assemble_new_candidate": true,
    "modify_existing_architecture": false,
    "rewrite_security_or_protected_mains": false,
    "reverse_architect_system": false,
    "failed_attempt_disposition": "HOLD_AND_LOG_ALLOW_DIFFERENT_APPROVED_PLAN",
    "failed_add_stays_on_disk": true,
    "different_skeleton_requires_clone": true
  },
  "audit": {
    "receipt_schema": "viv_cpu_candidate_assembly_receipt_v1",
    "append_only_ledger": true,
    "delete_api": "HOLD_DELETE_FORBIDDEN",
    "rename_api": "HOLD_RENAME_FORBIDDEN",
    "human_retention_authority_required": true,
    "human_archive_is_only_delete": true
  }
}
