    "live_weight_update": false,
    "seed_write": false,
    "promotion": false,
    "deployment": false
  },
  "matched_budget": {
    "effective_training_rows": 224,
    "repair_rows": 32,
    "sampler_index_space": 224,
    "replace_only_duplicate_occurrences": true,
    "preserve_unique_parent_keys": true
  },
  "acceptance": {
    "supported_query_floor": "12/16",
    "surface_count_floor": 4,
    "surface_floor": "2/4",
    "valid_scope_top_k_floor": "14/16",
    "stale_cpu_accepts": 0,
    "conflict_cpu_accepts": 0,
    "v4_ordinary_floor": "52/56",
    "v4_compositional_floor": "12/14",
