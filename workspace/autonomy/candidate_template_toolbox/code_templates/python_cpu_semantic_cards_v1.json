{
  "schema_version": "viv_cpu_semantic_card_v1",
  "purpose": "Metadata-only semantic routing cards for CPU tool selection",
  "fields": [
    "approved_catalog_id",
    "domain",
    "arity",
    "primary_operation",
    "secondary_operation",
    "primary_object",
    "secondary_object",
    "dependency_depth",
    "semantic_key"
  ],
  "operation_codes": {
    "guard": "g",
    "hash": "h",
    "validate": "v",
    "read": "r",
    "write": "w",
    "decide": "d",
    "normalize": "n",
    "measure": "m",
    "assemble": "a",
    "execute": "x",
    "train": "t",
    "identity": "i",
    "transform": "f"
  },
  "source_paths_present": false,
  "source_text_present": false,
  "function_bodies_present": false,
  "generated_python_present": false,
  "model_receives": "compact operation/object/arity labels only",
  "semantic_match_is_not_source_correctness": true,
  "human_approval_required_before_template_insertion": true
}
