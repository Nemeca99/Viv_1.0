{
  "schema_version": "viv_cpu_governed_clean_adaptive_gate_contract_v1",
  "purpose": "target_free_model_origin_adaptive_experiment_choice",
  "candidate_only": true,
  "isolated_required": true,
  "no_publish_required": true,
  "phase": "SCHEDULE",
  "model_output_grammar": "E|<experiment_slot>|<repeat_count>|<budget>",
  "fixed_width_wire": "viv_cpu_model_directed_fixed_width_wire_v1",
  "frame_width": 40,
  "padding_char": "~",
  "fixed_generation_budget": 40,
  "model_context_length": 128,
  "supported_rows": 16,
  "blocked_rows": 8,
  "approved_experiment_slots": [0, 1, 2, 3, 4],
  "approved_budgets": ["tiny", "small", "fixture"],
  "hidden_from_model": [
    "expected_experiment_slot",
    "expected_repeat_count",
    "expected_budget",
    "target_frame",
    "cpu_final_disposition",
    "post_schedule_state"
  ],
  "metadata_only": true,
  "source_bodies_in_model_packet": false,
  "native_paths_in_model_packet": false,
  "target_derived_budget": false,
  "raw_model_output_scored_without_repair": true,
  "cpu_validation_after_raw_model_output": true,
  "max_repeat_count": 3,
  "concurrent_execution": false,
  "daemon": false,
  "production_generation": false,
  "pointer_adoption": false,
  "seed_mutation": false,
  "live_model_mutation": false
}
