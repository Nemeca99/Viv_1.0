    "registry_mutation": false,
    "gpu_execution": false
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "line_endings": "LF",
    "sort_keys": true,
    "trailing_lf": true,
    "self_hash_field_omitted": "receipt_sha256",
    "volatile_fields_excluded_from_behavioral_digest": ["created_utc", "run_id", "wall_seconds", "inference_wall_seconds", "decision_id", "operation_id", "*_path"]
  }
