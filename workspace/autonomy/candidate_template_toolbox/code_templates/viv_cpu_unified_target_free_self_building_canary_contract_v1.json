    "seed": 43,
    "steps": 1024,
    "batch_size": 8,
    "learning_rate": 0.0005,
    "repeats": 2,
    "context_length": 128,
    "response_only_loss": true
  },
  "families": ["reflection", "query", "action", "variable", "result", "scheduler", "template"],
