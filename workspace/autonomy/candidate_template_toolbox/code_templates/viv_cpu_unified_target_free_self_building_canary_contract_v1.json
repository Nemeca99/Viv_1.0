{
  "schema_version": "viv_cpu_unified_target_free_self_building_canary_contract_v1",
  "receipt_schema": "viv_cpu_unified_target_free_self_building_receipt_v1",
  "purpose": "Evaluate one isolated CPU candidate trained on the target-free unified curriculum against disjoint current holdouts.",
  "parent": {
    "kind": "verified_v4_candidate",
    "candidate_only": true,
    "same_parent_for_control_and_candidate": true
  },
  "recipe": {
