{
  "schema_version": "viv_cpu_governed_current_proven_core_recheck_contract_v1",
  "receipt_schema": "viv_cpu_governed_current_proven_core_recheck_receipt_v1",
  "purpose": "Aggregate the newest independently verified CPU candidate attachments without claiming a unified checkpoint or production autonomy.",
  "mode": {
    "candidate_only": true,
    "isolated": true,
    "no_publish": true,
    "training_started": false,
    "source_catalog_rebuilt": false,
    "production_adoption": "closed"
  },
  "included_surfaces": [
    "current_reflection_query_chain",
    "current_model_origin_variable",
    "current_indexed_assembly_and_sandbox",
    "current_model_origin_result",
    "current_model_origin_adaptive_choice",
    "current_linked_recursive_cycle",
    "current_registry_multi_template_recheck"
  ],
  "not_claimed": [
    "unified_single_checkpoint",
    "fresh_live_model_origin",
    "production_self_modification",
    "pointer_adoption",
    "unrestricted_autonomy",
    "gpu_execution"
  ],
  "authority_rules": {
    "raw_model_output_is_required_for_model_origin": true,
    "cpu_repair_is_not_model_success": true,
    "rust_denial_expected": true,
    "human_approval_required_for_production": true,
    "protected_state_must_remain_unchanged": true,
    "specialized_receipts_do_not_merge_model_lineage": true
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "line_endings": "LF",
    "sort_keys": true,
    "trailing_lf": true,
    "self_hash_field_omitted": "receipt_sha256",
    "volatile_fields_excluded_from_comparison": [
      "created_utc",
      "run_id",
      "receipt_sha256",
      "rust_security.decision_id",
      "rust_security.operation_id",
      "rust_security.request_id"
    ]
  }
}
