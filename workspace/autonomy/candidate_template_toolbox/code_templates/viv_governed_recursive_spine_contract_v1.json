{
  "schema_version": "viv_governed_recursive_spine_v1",
  "status": "candidate_only",
  "purpose": "Link UML structure, RID integrity, AUTO state, and HHH semantic quality through one replayable recursive evidence spine.",
  "pillars": {
    "uml": "deterministic symbolic structure, semantic binding, and template shape",
    "rid": "physical/resource/integrity evidence consumed by Rust authority",
    "auto": "external input, autonomous state, lifecycle, queue, and scheduling",
    "hhh": "helpful, honest, and harmless semantic candidate quality"
  },
  "master_score": {
    "aggregation": "geometric_mean(rid, uml, auto, hhh)",
    "hhh_aggregation": "geometric_mean(helpful, honest, harmless)",
    "default_hhh_axis_floors": {
      "helpful": 0.0,
      "honest": 1.0,
      "harmless": 1.0
    },
    "missing_score_policy": "ABSTAIN",
    "stale_or_contradictory_policy": "HOLD",
    "rust_denial_policy": "HOLD",
    "score_never_opens_authority": true
  },
  "layers": ["GPU", "CPU", "UML", "RID", "AUTO", "RUST", "HUMAN"],
  "actors": ["MODEL", "CPU_RULE", "SCAFFOLD", "RUST", "HUMAN"],
  "lifecycle": [
    "OBSERVE",
    "PROPOSE",
    "INTERPRET",
    "CPU_VALIDATE",
    "CANDIDATE_PLAN",
    "SANDBOX_TEST",
    "MEASURE",
    "JUDGE",
    "RECORD",
    "SCHEDULE"
  ],
  "proposal_queue": {
    "max_items": 32,
    "backpressure": "HOLD_QUEUE_BACKPRESSURE",
    "silent_drop": false,
    "daemon": false
  },
  "metadata_only": {
    "source_paths": false,
    "source_bodies": false,
    "python": false,
    "shell": false,
    "generated_code": false,
    "checkpoint_paths": false
  },
  "authority": {
    "gpu": "proposal_only",
    "cpu": "semantic_and_evidence_judge",
    "uml": "structure_not_security",
    "rid": "measurement_not_security",
    "auto": "orchestration_not_security",
    "rust": "executable_and_write_membrane",
    "architect": "production_generation_and_pointer_adoption"
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "line_endings": "LF",
    "sorted_json_keys": true,
    "trailing_lf": true,
    "self_hash_excluded_field": "event_sha256"
  }
}
