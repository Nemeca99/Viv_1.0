{
  "schema_version": "viv_cpu_independent_reflection_v1",
  "receipt_schema": "viv_cpu_independent_reflection_receipt_v1",
  "frame_schema": "viv_cpu_autonomy_reflection_frame_v1",
  "frame_width": 80,
  "padding_char": "~",
  "device": "cpu",
  "model_training": false,
  "cli_guards": ["--isolated", "--no-publish"],
  "model_outputs": [
    "NO_DEFICIENCY",
    "DEFICIENCY_CANDIDATE|<surface_slot>|<evidence_slot>|<observed_metric>|<expected_metric>"
  ],
  "surface_slots": ["rid", "auto", "uml", "documentation", "model_protocol"],
  "observed_metrics": [
    "coverage_gap",
    "adaptive_repeat",
    "protocol_hold",
    "stale_evidence",
    "no_deficiency",
    "insufficient_context"
  ],
  "expected_metrics": [
    "coverage_gap",
    "adaptive_repeat",
    "protocol_hold",
    "stale_evidence",
    "no_deficiency",
    "insufficient_context",
    "stable",
    "evidence_conditioned"
  ],
  "card_states": ["SUPPORTED_DEFICIENCY", "CLEAN", "INSUFFICIENT", "CONTRADICTORY"],
  "lifecycle": [
    "OBSERVE",
    "REFLECT",
    "CPU_VALIDATE",
    "RECORD",
    "COMPLETE",
    "HOLD",
    "ABSTAIN"
  ],
  "forbidden_model_content": [
    "native_paths",
    "source_bodies",
    "python",
    "shell",
    "executable_content",
    "checkpoint_paths",
    "post_decision_fields",
    "expected_output_frame"
  ],
  "holdout": {
    "supported_deficiency_rows": 8,
    "clean_rows": 4,
    "insufficient_or_contradictory_rows": 4,
    "minimum_deficiency_success": 6,
    "minimum_clean_success": 3,
    "minimum_surface_slots": 2,
    "minimum_non_coverage_successes": 1
  },
  "determinism": {
    "repeats": 2,
    "temperature": 0.0,
    "top_k": null,
    "top_p": null,
    "repetition_penalty": 1.0,
    "attention_backend": "sdpa",
    "draft_mode": "cpu_gate"
  },
  "protected_boundaries": {
    "seed_mutation": false,
    "live_model_mutation": false,
    "optimizer_calls": false,
    "checkpoint_writes": false,
    "gpu_execution": false,
    "registry_mutation": false,
    "production_generation": false,
    "template_insertion": false,
    "rust_python_write_open": false,
    "human_approval_required_for_adoption": true
  },
  "security": {
    "production_write_probe": "HOLD_SECURITY",
    "unauthorized_cpu_accepts": 0
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "line_endings": "LF",
    "sort_keys": true,
    "trailing_lf": true,
    "volatile_fields_excluded_from_comparison": [
      "created_utc",
      "run_id",
      "repeat_index",
      "wall_seconds",
      "decision_id",
      "receipt_sha256"
    ]
  }
}
