{
  "schema_version": "viv_negative_result_challenge_contract_v1",
  "report_schema": "viv_negative_result_challenge_report_v1",
  "purpose": "Challenge negative-looking receipts before using them as capability conclusions.",
  "challenge_statuses": [
    "SUPPORTED_BOUNDED_NEGATIVE",
    "NOT_OBSERVED",
    "REPRESENTATION_OR_INTEGRATION_FAILURE",
    "EVALUATOR_BOUNDARY_FAILURE",
    "AUTHORITY_HOLD",
    "UNRESOLVED"
  ],
  "bounded_probes": [
    "RETAIN_SCOPED_NEGATIVE",
    "CAPTURE_FRESH_READ_ONLY_SAMPLE",
    "REPLAY_WITH_PROTOCOL_COMPATIBILITY",
    "REBUILD_TARGET_FREE_EVALUATOR",
    "RETAIN_AUTHORITY_HOLD_SEPARATELY",
    "DESIGN_ORTHOGONAL_REPLICATION",
    "INSPECT_SOURCE_SPECIFICALLY"
  ],
  "rules": {
    "negative_is_a_hypothesis": true,
    "original_receipts_immutable": true,
    "raw_output_is_not_repaired": true,
    "cpu_or_rust_hold_is_not_model_failure": true,
    "missing_sample_is_not_capability_failure": true,
    "one_narrow_utility_definition_does_not_generalize": true,
    "evaluator_target_leakage_invalidates_model_origin_claim": true
  },
  "metadata_policy": {
    "native_paths": false,
    "source_bodies": false,
    "raw_model_text": false,
    "repository_relative_receipts_only": true
  },
  "canonicalization": {
    "encoding": "UTF-8",
    "line_endings": "LF",
    "sorted_json_keys": true,
    "trailing_lf": true
  }
}
