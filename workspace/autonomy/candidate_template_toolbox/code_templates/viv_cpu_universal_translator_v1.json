  "classes": [
    "LANGUAGE_PROPOSAL",
    "TRUTH_ANCHORED",
    "HOLD_LIE",
    "ABSTAIN"
  ],
  "emit": {
    "TRUTH_ANCHORED": "lossless_mouth_text_as_fact",
    "LANGUAGE_PROPOSAL": "tagged_language_not_fact",
    "HOLD_LIE": "no_emit",
    "ABSTAIN": "no_emit"
  },
  "forbidden": {
    "gpu_authors_fact": true,
    "hold_painted_as_pass": true,
    "skip_end_gate": true,
    "kill_pretrain": true
  }
