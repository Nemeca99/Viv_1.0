      "source_bytes_in_request": false,
      "python_bodies_in_request": false,
      "human_approval_required_before_template_insertion": true
    },
    "cpu_semantic_cards": {
      "schema_version": "viv_cpu_semantic_card_v1",
      "metadata_only": true,
      "source_paths_in_model_prompt": false,
