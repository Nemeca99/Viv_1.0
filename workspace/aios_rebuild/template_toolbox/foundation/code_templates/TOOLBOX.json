      "source_paths_in_model_prompt": false,
      "source_text_in_model_prompt": false,
      "function_bodies_in_model_prompt": false,
      "typed_ambiguity_labels": true,
      "cpu_is_final_disposition_authority": true,
      "target_pillars_are_never_inferred": true,
      "semantic_match_is_not_source_correctness": true
    }
  },
  "code_authoring_policy": {
    "ordinary_code_generation": false,
    "template_authoring_exception": true,
    "human_approval_required": true,
    "ai_may_propose_template_changes": true,
    "normal_execution_changes": "declared_variable_values_only",
    "reference_rebuild_writes": "isolated_only",
    "sandbox_new_function": "allowed_as_disposable_candidate_only; Rust hypothetical-write decision required",
