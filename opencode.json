  "mcp": {
    "servers": {
      "aios_router": {
        "type": "local",
        "command": [
          "wsl.exe",
          "--distribution",
          "Ubuntu",
          "--exec",
          "docker",
          "--context",
          "default",
          "run",
          "--rm",
          "--interactive",
          "--pull=never",
          "--network=none",
          "--read-only",
          "--cap-drop=ALL",
          "--security-opt=no-new-privileges:true",
          "--user=10001:10001",
          "--memory=256m",
          "--memory-swap=256m",
          "--cpus=1",
          "--pids-limit=32",
          "--shm-size=8m",
          "--mount",
          "type=bind,source=/mnt/l/LocalCoder/workspace/aios_rebuild/memory/aios_router,target=/var/lib/aios-router",
          "--mount",
          "type=volume,source=aios-router-postal-key-v1,target=/var/lib/aios-router-key",
          "--mount",
          "type=bind,source=/mnt/l/LocalCoder/.opencode/receipts,target=/var/lib/aios-body-receipts,readonly",
          "--mount",
          "type=bind,source=/mnt/f/AI_Datasets/domain_dbs,target=/var/lib/aios-wikipedia,readonly",
          "--mount",
          "type=bind,source=/mnt/l/LocalCoder,target=/var/lib/aios-project,readonly",
          "sha256:bc26b04fb32ffffb54749be70814711f3aa3a4a6da1b723b0cf9a321ce63731d"
        ],
        "disabled": false,
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 15000,
          "execution": 30000
        }
      },
      "openpets": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "@open-pets/mcp"
        ],
        "disabled": false,
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 15000,
          "execution": 30000
        }
      }
    }
