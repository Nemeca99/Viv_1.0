          "modelID": "omnicoder-2-9b",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": false
            }
          },
          "limit": {
            "context": 16384,
            "output": 4096
