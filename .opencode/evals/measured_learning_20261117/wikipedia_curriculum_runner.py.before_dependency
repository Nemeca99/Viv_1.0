    parser = argparse.ArgumentParser(description="Autonomous Wikipedia Curriculum Runner (Dual-Parser Gated)")
    parser.add_argument("--max-lessons", type=int, default=5, help="Number of sentences to acquire")
    parser.add_argument("--duration-minutes", type=float, default=0.0, help="Max duration in minutes")
    parser.add_argument("--categories", type=str, default="", help="Comma-separated categories to prioritize (e.g. bird,plant)")
    args = parser.parse_args()
    run_wikipedia_curriculum(max_lessons=args.max_lessons, duration_minutes=args.duration_minutes, categories=args.categories)


if __name__ == "__main__":
    main()
